<sumoConfiguration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/sumoConfiguration.xsd">

    <input>
        <net-file value="D:\system\System-of-the-control-traffic-light-master\data\ntut_network_split.net.xml" />
        <route-files value="D:\system\System-of-the-control-traffic-light-master\data\analysis\_mp_runs\traffic_data_20260529_003200\traffic_data_20260529_003200_filtered.rou.xml" />
        <additional-files value="D:\system\System-of-the-control-traffic-light-master\data\analysis\_mp_runs\traffic_data_20260529_003200\traffic_data_20260529_003200_edgedata.add.xml" />
    </input>

    <output>
        <output-prefix value="" />
        <tripinfo-output value="D:\system\System-of-the-control-traffic-light-master\data\tripinfos.xml" />
        <statistic-output value="D:\system\System-of-the-control-traffic-light-master\data\analysis\_mp_runs\traffic_data_20260529_003200\traffic_data_20260529_003200_mp_stats.xml" />
    </output>

    <processing>
        <ignore-route-errors value="true" />
        <tls.actuated.jam-threshold value="30" />
    </processing>

    <routing>
        <device.rerouting.adaptation-steps value="18" />
        <device.rerouting.adaptation-interval value="10" />
    </routing>

    <report>
        <verbose value="true" />
        <duration-log.statistics value="true" />
        <no-step-log value="true" />
    </report>

</sumoConfiguration>